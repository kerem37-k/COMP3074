<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="56dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pay Calculator"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/editHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of Hours Worked"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />



        <EditText
            android:id="@+id/editRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hourly Rate"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />



        <EditText
            android:id="@+id/editTax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tax Rate (e.g. 0.13)"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />


        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/textPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pay: $0.00"
            android:textSize="18sp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/textOvertime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overtime Pay: $0.00"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/textTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Pay: $0.00"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/textTax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tax: $0.00"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About"
            android:layout_marginTop="28dp" />

    </LinearLayout>
</ScrollView>
